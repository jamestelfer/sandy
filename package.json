{
  "name": "sandy",
  "version": "0.8.0",
  "type": "module",
  "bin": {
    "sandy": "./dist/sandy"
  },
  "scripts": {
    "prebuild": "bun scripts/pack-embedded.ts",
    "build": "bun run --silent build-binary && bun run --silent resign",
    "build-binary": "bun build --compile --target=bun src/main.ts --outfile dist/sandy",
    "resign": "./bin/resign.sh",
    "pretest": "bun scripts/pack-embedded.ts",
    "test": "bun test --ignore='embedded/**'",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix --unsafe .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "fix": "bun run lint:fix && bun run format:fix",
    "verify": "biome check . && bun run build && bun run test && bun run integration:docker",
    "integration": "INTEGRATION=true bun test --testPathPattern integration",
    "integration:docker": "INTEGRATION=true bun test src/sandbox/docker-backend.integration.test.ts src/sandbox/docker-endpoint.integration.test.ts --max-concurrency 1",
    "integration:shuru": "INTEGRATION=true bun test src/sandbox/shuru-backend.integration.test.ts"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@superhq/shuru": "^0.4.2",
    "dockerode": "^5.0.1",
    "human-id": "^4.2.0",
    "memfs": "^4.67.0",
    "tar-fs": "^3.1.3",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/dockerode": "^4.0.1",
    "@types/yargs": "^17.0.35",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0"
  }
}
